generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String        @id @default(uuid())
  name        String
  email       String        @unique
  password    String
  limit       Decimal
  dueDay      Int           @map("due_day")
  closingDay  Int           @map("closing_day")
  avatar      String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  card        Card[]
  invoice     Invoice[]
  application Application[]
  shopping    Shopping[]
  Movements   Movement[]

  @@map("users")
}

model Card {
  id         String     @id @default(uuid())
  name       String
  dueDay     Int        @map("due_day")
  closingDay Int        @map("closing_day")
  colorFont  String     @map("color_font")
  colorCard  String     @map("color_card")
  active     Boolean    @default(true)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  shopping   Shopping[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@map("cards")
}

enum TypeInvoice {
  FIXED_EXPENSE
  EXTRA_EXPENSE
}

enum PaymentMethod {
  INVOICE
  CARD
  MONEY
}

model Shopping {
  id                String        @id @default(uuid())
  name              String
  typeInvoice       TypeInvoice   @map("type_invoice")
  paymentMethod     PaymentMethod @map("payment_method")
  value             Decimal
  totalInstallments Int           @map("total_installments")
  pay               Boolean       @default(false)
  description       String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  installment       Installment[]

  card   Card?   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId String? @map("card_id")

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String   @map("category_id")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String     @map("user_id")
  Movements Movement[]

  @@map("shopping")
}

model Installment {
  id                String   @id @default(uuid())
  installmentNumber Int      @map("installment_number")
  installmentValue  Decimal  @map("installment_value")
  dueDate           DateTime @map("due_date")
  pay               Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  shopping   Shopping @relation(fields: [shoppingId], references: [id], onDelete: Cascade)
  shoppingId String   @map("shopping_id")

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String  @map("invoice_id")

  @@map("installments")
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  shopping  Shopping[]

  @@map("categories")
}

model Invoice {
  id          String        @id @default(uuid())
  pay         Boolean       @default(false)
  dueDate     DateTime      @unique @map("due_date")
  closingDate DateTime      @unique @map("closing_date")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  installment Installment[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@map("invoices")
}

model Application {
  id               String    @id @default(uuid())
  name             String
  targetValue      Decimal   @map("target_value")
  value            Decimal
  institution      String
  colorFont        String    @map("color_font")
  colorApplication String    @map("color_application")
  icon             String
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  extract          Extract[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@map("applications")
}

enum TypeExtract {
  DEPOSIT
  WITHDRAW
  INCOME
}

model Extract {
  id        String      @id @default(uuid())
  type      TypeExtract
  value     Decimal
  createdAt DateTime    @default(now()) @map("created_at")

  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String      @map("application_id")
  Movements     Movement[]

  @@map("extracts")
}

enum TypeMovement {
  DEPOSIT
  WITHDRAW
  INVOICE
  CARD
  MONEY
  INCOME
}

model Movement {
  id          String       @id @default(uuid())
  name        String
  type        TypeMovement
  value       Decimal
  installment Int?
  createdAt   DateTime     @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  extract   Extract? @relation(fields: [extractId], references: [id])
  extractId String?  @map("extract_id")

  shopping   Shopping? @relation(fields: [shoppingId], references: [id])
  shoppingId String?   @map("shopping_id")

  @@map("movements")
}
